{
  "name": "stack-compass",
  "version": "2.0.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "stack-compass": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx tests/run-all.ts"
  },
  "keywords": [
    "mcp",
    "documentation",
    "monorepo",
    "stack"
  ],
  "author": "",
  "license": "Apache-2.0",
  "description": "MCP server that detects project frameworks from pom.xml, build.gradle, build.sbt, package.json, Docker, and K8s configs — then serves on-demand documentation for each.",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.9.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-scala": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "turndown": "^7.2.4",
    "web-tree-sitter": "^0.26.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
